# Copy this file to .env on the Docker host. Do not commit .env.
# Keep the database password URL-safe because Compose inserts it into DATABASE_URL.
POSTGRES_DB=whereabouts_hamburg
POSTGRES_USER=whereabouts
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters

# pgAdmin login. Generate its password with: openssl rand -hex 32
PGADMIN_DEFAULT_EMAIL=admin@whereabouts-hamburg.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-long-random-password

# Use true behind an HTTPS reverse proxy. Use false only for direct HTTP access.
SESSION_COOKIE_SECURE=true

# Public contact shown in the analytics privacy notice. Required in production.
PRIVACY_CONTACT_EMAIL=privacy@example.com

# Optional comma-separated Account IDs excluded from dashboard metrics.
ANALYTICS_EXCLUDED_ACCOUNT_IDS=

# Set APP_BIND_ADDRESS=127.0.0.1 when a reverse proxy runs on this Docker host.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8000
